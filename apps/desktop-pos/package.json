{
  "name": "qazipro-desktop-pos",
  "version": "0.1.0",
  "description": "QaziPRO online and offline Windows point-of-sale with automatic restaurant synchronization",
  "author": "Qazi Raheel",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env ELECTRON_RENDERER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "tsc -b && vite build",
    "start": "electron .",
    "package:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-icon.ps1 && cross-env DESKTOP_RELEASE_BUILD=true npm run build && electron-builder --config.electronDist=../../node_modules/electron/dist --win nsis portable"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.115.0",
    "dexie": "^4.2.1",
    "electron-updater": "6.8.10",
    "gsap": "^3.15.0",
    "lucide-react": "^1.40.0",
    "motion": "^13.4.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "44.3.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5",
    "vite": "^7.1.7",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "pk.qazipro.desktoppos",
    "productName": "QaziPRO POS Desktop",
    "protocols": [
      {
        "name": "QaziPRO POS secure sign-in",
        "schemes": [
          "qazipro-pos",
          "italianpizza-pos"
        ]
      }
    ],
    "files": [
      "dist/**/*",
      "electron/**/*",
      "build/icon.png",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
