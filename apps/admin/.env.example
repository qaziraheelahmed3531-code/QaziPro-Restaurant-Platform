# PUBLIC — safe browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe Google Maps JavaScript key. Restrict by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# SERVER-ONLY cache invalidation bridge
CUSTOMER_APP_URL=
REVALIDATION_SECRET=

# Ordinary admin CRUD uses staff RLS and does not require a service-role key.

# OPTIONAL SERVER SECRET - integration diagnostics (set on owning app only)
GEOAPIFY_API_KEY=
GOOGLE_PLACES_API_KEY=

# OPTIONAL PAYMENT - disabled until a verified provider adapter is enabled
PAYMENT_MODE=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_WEBHOOK_SECRET=

# SERVER-ONLY transactional email used for order confirmations
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# SERVER-ONLY staff invitation delivery (Supabase custom SMTP is configured in its dashboard)
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_APP_URL=http://localhost:3001
# Add the same REVALIDATION_SECRET to the customer deployment, too.

NEXT_PUBLIC_GEOAPIFY_MAPS_KEY=
