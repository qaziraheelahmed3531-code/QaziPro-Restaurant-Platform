# Server-only Geoapify credential
GEOAPIFY_API_KEY=

# Server-only Google Business Profile OAuth credentials
GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_OAUTH_REFRESH_TOKEN=
GOOGLE_BUSINESS_ACCOUNT_ID=
GOOGLE_BUSINESS_LOCATION_ID=
# Optional public Google URL used by the "Write a Review" button
GOOGLE_BUSINESS_REVIEW_URL=

# Server-only Places API (New) configuration for Google reviews
GOOGLE_PLACES_API_KEY=
# Optional: skips Text Search (New) when the verified Place ID is known
GOOGLE_PLACES_PLACE_ID=

# Server-only SociableKIT Google Reviews JSON data-feed URL
SOCIABLEKIT_GOOGLE_REVIEWS_FEED_URL=

# Restaurant origin used for driving routes and delivery fees
ITALIAN_PIZZA_LAT=
ITALIAN_PIZZA_LON=

# Public Supabase Auth configuration (publishable key only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser-safe Google Maps JavaScript key. Restrict by HTTP referrer in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Server-only order persistence and admin-triggered storefront refresh
SUPABASE_SERVICE_ROLE_KEY=
REVALIDATION_SECRET=

# OPTIONAL PAYMENT SERVER SECRETS - no gateway enabled by setting names alone
PAYMENT_MODE=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=
PAYFAST_WEBHOOK_SECRET=

# OPTIONAL EMAIL - Supabase Auth sends email using dashboard SMTP settings
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

NEXT_PUBLIC_GEOAPIFY_MAPS_KEY=
