{
  "name": "@qazipro/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom",
        "react-native-safe-area-context",
        "react-native-screens"
      ]
    }
  },
  "scripts": {
    "start": "node scripts/start.mjs",
    "web": "node scripts/start.mjs web",
    "android": "node scripts/start.mjs android",
    "ios": "node scripts/start.mjs ios",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build:android": "expo export --platform android --output-dir dist/android",
    "build:ios": "expo export --platform ios --output-dir dist/ios",
    "build:operations:android": "node scripts/export-operations.mjs android",
    "build:operations:ios": "node scripts/export-operations.mjs ios",
    "build:operations:web": "node scripts/export-operations.mjs web",
    "build:operations": "npm run build:operations:android && npm run build:operations:ios && npm run build:operations:web",
    "test:operations:web": "node scripts/test-operations-web.mjs",
    "build": "npm run typecheck && npm run build:android && npm run build:ios"
  },
  "dependencies": {
    "@italian-pizza/shared": "file:../../packages/shared",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@supabase/supabase-js": "^2.115.0",
    "expo": "~57.0.26",
    "expo-constants": "~57.0.20",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-haptics": "~57.0.3",
    "expo-linking": "~57.0.11",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "lucide-react-native": "^1.49.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.10.0",
    "react-native-screens": "~4.28.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.4",
    "eslint": "^9.39.1",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "^4.0.18"
  }
}
