# Preview/staging only. Never point local or preview forms at Production Supabase.
APP_ENVIRONMENT=staging
NEXT_PUBLIC_SITE_URL=http://localhost:3003
NEXT_PUBLIC_CLIENT_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_SUPER_ADMIN_URL=http://localhost:3002
# Set only when the isolated Restaurant Admin demo tenant is configured.
NEXT_PUBLIC_DEMO_PORTAL_URL=
STAGING_SUPABASE_PROJECT_REF=
SUPABASE_PROJECT_REF=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PUBLIC_LEADS_ENABLED=0
CMS_REVALIDATE_SECRET=
# Optional email webhook; never place its secret in NEXT_PUBLIC variables.
LEAD_NOTIFICATION_WEBHOOK_URL=
LEAD_NOTIFICATION_WEBHOOK_SECRET=
# Optional privacy-aware analytics. Leave blank to load no analytics script.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
